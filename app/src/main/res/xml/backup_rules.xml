<?xml version="1.0" encoding="utf-8"?><!--
   API 28-30 path. `android:allowBackup="false"` already stops backups here, so
   these rules are a belt-and-braces restatement of the same intent; see
   res/xml/data_extraction_rules.xml for why nothing is backed up.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
