          "skippable": true,
          "options": [
            { "id": "quote_of_day", "text": { "en": "Quote of the day", "uk": "Цитата дня" } },
            { "id": "saved_reminder", "text": { "en": "A reminder to revisit my saved quotes", "uk": "Нагадування перечитати збережені цитати" } },
            { "id": "reading_streak", "text": { "en": "My reading streak", "uk": "Моя серія днів поспіль" } },
            { "id": "new_collections", "text": { "en": "New curated collections", "uk": "Нові добірки цитат" } },
            { "id": "widget_tips", "text": { "en": "Widget ideas and tips", "uk": "Ідеї та поради для віджета" } },
            {
              "id": "other",
              "text": { "en": "Something else", "uk": "Щось інше" },
              "input": {
                "required": true,
                "label": { "en": "What exactly?", "uk": "Що саме?" },
                "placeholder": { "en": "Describe the notification you would like", "uk": "Опиши сповіщення, яке хотів би отримувати" }
              }
            }
          ]
        },
        {
          "id": "timing",
          "title": { "en": "When would it be welcome?", "uk": "Коли це було б доречно?" },
          "description": { "en": "Pick one", "uk": "Обери один варіант" },
          "multiSelect": false,
          "skippable": true,
          "options": [
            { "id": "morning", "text": { "en": "Morning", "uk": "Зранку" } },
            { "id": "midday", "text": { "en": "Around midday", "uk": "Опівдні" } },
            { "id": "evening", "text": { "en": "Evening", "uk": "Увечері" } },
            { "id": "night", "text": { "en": "Late at night", "uk": "Пізно ввечері" } }
          ]
        },
        {
          "id": "blocker",
          "title": {
            "en": "What would make you turn notifications off?",
            "uk": "Що змусило б тебе вимкнути сповіщення?"
          },
          "description": { "en": "Pick one and add details", "uk": "Обери один і додай деталі" },
          "multiSelect": false,
          "skippable": true,
          "options": [
            { "id": "too_often", "text": { "en": "Too many of them", "uk": "Їх забагато" } },
            { "id": "irrelevant", "text": { "en": "Content that does not fit me", "uk": "Контент, який мені не підходить" } },
            { "id": "wrong_time", "text": { "en": "Arriving at the wrong time", "uk": "Приходять не вчасно" } },
            { "id": "no_push_at_all", "text": { "en": "I keep notifications off everywhere", "uk": "Я скрізь тримаю сповіщення вимкненими" } },
            {
              "id": "other",
              "text": { "en": "Something else", "uk": "Щось інше" },
              "input": {
                "required": true,
                "label": { "en": "Tell us more", "uk": "Розкажи більше" },
                "placeholder": { "en": "What would annoy you?", "uk": "Що б тебе дратувало?" }
              }
            }
          ]
        }
      ]
    }
