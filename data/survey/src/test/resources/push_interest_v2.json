          "uk": "Чотири швидкі питання — від них залежить, чи робимо ми пуші взагалі."
        },
        "reward": {
          "en": "Reward — a new widget background",
          "uk": "Нагорода — новий фон для віджета"
        }
      },
      "questions": [
        {
          "id": "interest",
          "title": {
            "en": "Would you want Quotify to send you notifications?",
            "uk": "Хотів би отримувати сповіщення від Quotify?"
          },
          "description": { "en": "Pick one", "uk": "Обери один варіант" },
          "multiSelect": false,
          "skippable": false,
          "options": [
            { "id": "daily", "text": { "en": "Yes, every day", "uk": "Так, щодня" } },
            { "id": "few_week", "text": { "en": "Yes, a few times a week", "uk": "Так, кілька разів на тиждень" } },
            { "id": "rare", "text": { "en": "Only occasionally", "uk": "Лише зрідка" } },
            {
              "id": "never",
              "text": { "en": "No, I would turn them off", "uk": "Ні, я б їх вимкнув" },
              "input": {
                "required": false,
                "label": { "en": "Why not?", "uk": "Чому ні?" },
                "placeholder": { "en": "A word or two is enough", "uk": "Достатньо кількох слів" }
              }
            }
          ]
        },
        {
          "id": "content",
          "title": {
            "en": "What would be worth a notification?",
            "uk": "Заради чого варто присилати сповіщення?"
