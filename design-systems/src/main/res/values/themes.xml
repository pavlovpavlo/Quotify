<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Splash theme — used as the *initial* activity theme so the Android 12+
        system splash (and the AndroidX SplashScreen back-compat layer on older
        versions) shows the Folio paper color instead of the default white.

        installSplashScreen() in MainActivity hands off to postSplashScreenTheme
        once Compose is ready, at which point the in-app SplashScreen composable
        takes over.

        The icon is intentionally omitted (we draw our own lottie + logo in the
        Compose splash); the system splash just shows the colored window.
    -->
    <style name="Theme.Quotify.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/folio_paper</item>
        <item name="postSplashScreenTheme">@style/Theme.Quotify</item>
    </style>

    <style name="Theme.Quotify" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/folio_paper</item>
    </style>
</resources>
