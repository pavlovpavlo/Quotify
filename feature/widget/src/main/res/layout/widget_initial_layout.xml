<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown by the launcher while Glance has not rendered yet — most visibly right
  after a reboot. The Glance default placeholder is a spinner on a bare surface,
  which reads as a broken white card; this one is just the widget's own
  background, so the restore looks like an empty widget instead.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_placeholder_background" />
